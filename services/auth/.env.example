PORT=3001

# Base de datos PostgreSQL exclusiva de Auth
# Docker: usar el host postgres
# Windows/local: usar localhost
DATABASE_URL="postgresql://gaby_auth:CAMBIAR@localhost:5432/gaby_auth?schema=public"

# Autenticación JWT
JWT_SECRET="CAMBIAR_POR_UNA_CLAVE_SEGURA"
JWT_EXPIRES_IN="2h"